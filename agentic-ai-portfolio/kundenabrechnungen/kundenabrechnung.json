    {
      "parameters": {
        "jsCode": "const projects = {};\n\n// 1. Alle offenen Einträge durchgehen und nach Projekt zusammenfassen\nfor (const item of $input.all()) {\n  const data = item.json;\n  const name = data.Projektname;\n  const stunden = parseFloat(data.Stunden) || 0;\n  const satz = parseFloat(data.Stundensatz) || 0;\n  const budget = parseFloat(data.Projektbudget) || 0;\n\n  if (!projects[name]) {\n    projects[name] = {\n      Projektname: name,\n      Gesamtstunden: 0,\n      Stundensatz: satz,\n      Projektbudget: budget,\n      Umsatz: 0\n    };\n  }\n\n  projects[name].Gesamtstunden += stunden;\n}\n\n// 2. Umsatz für jedes Projekt berechnen (Stunden * Satz)\nconst output = Object.values(projects).map(project => {\n  project.Umsatz = project.Gesamtstunden * project.Stundensatz;\n  return { json: project };\n});\n\nreturn output;"
      },
